# PayLedger API — production image
FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
COPY apps/api/package.json apps/api/
RUN npm install --workspace apps/api --include-workspace-root

FROM node:22-alpine AS build
WORKDIR /app
COPY --from=deps /app/node_modules node_modules
COPY apps/api apps/api
COPY package.json ./
WORKDIR /app/apps/api
# scripts/generate.mjs = `prisma generate` with an offline-safe fallback
RUN node scripts/generate.mjs && npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/node_modules node_modules
COPY --from=build /app/apps/api/dist dist
COPY --from=build /app/apps/api/prisma prisma
# Portable migration runner (no Prisma engine binaries needed at runtime).
# Records applied files in _prisma_migrations, so it is safe alongside
# `prisma migrate deploy` in environments that do have engine access.
COPY --from=build /app/apps/api/scripts scripts
COPY --from=build /app/apps/api/package.json package.json
EXPOSE 3001
CMD ["sh", "-c", "node scripts/migrate.mjs && node dist/main.js"]
