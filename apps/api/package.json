{
  "name": "@payledger/api",
  "version": "0.1.0",
  "private": true,
  "description": "PayLedger NestJS API \u2014 auth, tax engine, double-entry ledger, payroll, ACH simulation",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest --runInBand",
    "test:watch": "jest --runInBand --watch",
    "test:coverage": "jest --runInBand --coverage",
    "seed": "QUEUE_DRIVER=memory ACH_SETTLE_DELAY_MS=999999999 PAYROLL_PROCESS_DELAY_MS=999999999 ts-node --transpile-only -r dotenv/config src/seed.ts",
    "generate": "node scripts/generate.mjs",
    "migrate": "node scripts/migrate.mjs",
    "prisma:generate": "node scripts/generate.mjs",
    "prisma:deploy": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/platform-express": "^11.2.8",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.34.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.2",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.2.8",
    "@prisma/schema-engine-wasm": "8.1.0-1.d1b3f377ca835d73fd50954a5e22128b9ebdd6b8",
    "@prisma/driver-adapter-utils": "7.10.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "prisma": "7.10.1",
    "supertest": "^7.1.1",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  }
}
