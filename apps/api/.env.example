# PayLedger API environment (development defaults — safe for local demo)
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/payledger
SHADOW_DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/payledger_shadow
JWT_SECRET=dev-only-not-for-production-payledger-secret
JWT_EXPIRES_IN=12h
PORT=3001
WEB_ORIGIN=http://localhost:3000
# auto = use BullMQ when REDIS_URL is reachable, otherwise in-process queue driver
QUEUE_DRIVER=auto
REDIS_URL=redis://127.0.0.1:6379
# simulated ACH settlement delay (ms)
ACH_SETTLE_DELAY_MS=6000
ACH_PROCESSING_DELAY_MS=1500
PAYROLL_PROCESS_DELAY_MS=1200
ENCRYPTION_KEY=dev-encryption-key-32-bytes-long!!
STORAGE_DIR=./storage
